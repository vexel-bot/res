# syntax=docker/dockerfile:1.7

FROM python:3.11-slim@sha256:272efc3f94bec901e2bc7a5c9984b3d113c317839edca2714c6a388b9476f8fc AS source-audit

ARG OPENVOICE_REVISION=74a1d147b17a8c3092dd5430504bd83ef6c7eb23
ARG OPENVOICE_LICENSE_DIGEST=bb3541f421e6273d3a3e3dd5bdba2bd3b79a3c2eadca65cde9c62c2467903ac0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git init /src/openvoice \
    && git -C /src/openvoice remote add origin https://github.com/myshell-ai/OpenVoice.git \
    && git -C /src/openvoice fetch --depth=1 origin "${OPENVOICE_REVISION}" \
    && git -C /src/openvoice checkout --detach FETCH_HEAD \
    && test "$(git -C /src/openvoice rev-parse HEAD)" = "${OPENVOICE_REVISION}" \
    && test "$(sha256sum /src/openvoice/LICENSE | awk '{print $1}')" = "${OPENVOICE_LICENSE_DIGEST}" \
    && python -m pip wheel --disable-pip-version-check --no-cache-dir --no-deps \
        --wheel-dir /wheels /src/openvoice

FROM python:3.11-slim@sha256:272efc3f94bec901e2bc7a5c9984b3d113c317839edca2714c6a388b9476f8fc AS dependencies

ARG CANDIDATE_LOCK_DIGEST=d56c6da1f8ca807460085f7eb982313aeedc5be33b730d0cd2aab601018e28dd
ARG ESPEAK_RUNTIME_MANIFEST_DIGEST=9af3512043451d19ce36cd3721da52231d6e28931d44b2ffbd07cce6350be373

COPY --from=ghcr.io/astral-sh/uv:0.12.3@sha256:dfd1e6972e100ca2fbf1f391effc3dd4aa57f319bf03c3e321e0a3f3341ed5af /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/clicko/candidate
COPY workers/speech-gpu/candidate/openvoice/pyproject.toml ./pyproject.toml
COPY workers/speech-gpu/candidate/openvoice/uv.lock ./uv.lock
COPY backend/scripts/verify_speech_gpu_candidate_lock.py ./verify_lock.py
RUN test "$(sha256sum uv.lock | awk '{print $1}')" = "${CANDIDATE_LOCK_DIGEST}" \
    && python verify_lock.py uv.lock --candidate openvoice \
    && uv sync --frozen --no-dev --no-install-project

COPY --from=source-audit /wheels /wheels
RUN uv pip install --python .venv/bin/python --no-deps /wheels/*.whl

COPY backend/app/__init__.py /opt/clicko/backend/app/__init__.py
COPY backend/app/domain/__init__.py /opt/clicko/backend/app/domain/__init__.py
COPY backend/app/domain/studios/contracts.py /opt/clicko/backend/app/domain/studios/contracts.py
COPY backend/app/domain/studios/speech_assets.py /opt/clicko/backend/app/domain/studios/speech_assets.py
COPY backend/scripts/install_espeak_runtime_replacement.py /opt/clicko/backend/scripts/install_espeak_runtime_replacement.py
COPY .candidate-build/espeak-runtime /opt/clicko/espeak-runtime
COPY .candidate-build/espeak-runtime.manifest.json /opt/clicko/espeak-runtime.manifest.json
RUN PYTHONPATH=/opt/clicko/backend .venv/bin/python -c \
        "from pathlib import Path; from app.domain.studios.speech_assets import EspeakRuntimeManifestV1, espeak_runtime_manifest_digest; p=Path('/opt/clicko/espeak-runtime.manifest.json'); m=EspeakRuntimeManifestV1.model_validate_json(p.read_text()); assert espeak_runtime_manifest_digest(m) == '${ESPEAK_RUNTIME_MANIFEST_DIGEST}'" \
    && loader_root="$(.venv/bin/python -c 'from pathlib import Path; import espeakng_loader; print(Path(espeakng_loader.__file__).parent)')" \
    && PYTHONPATH=/opt/clicko/backend .venv/bin/python \
        /opt/clicko/backend/scripts/install_espeak_runtime_replacement.py \
        --manifest /opt/clicko/espeak-runtime.manifest.json \
        --runtime-root /opt/clicko/espeak-runtime \
        --loader-root "${loader_root}" \
    && HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 .venv/bin/python -c \
        "import wavmark; from kokoro import KModel, KPipeline; from openvoice.api import ToneColorConverter; assert wavmark and KModel and KPipeline and ToneColorConverter"

FROM python:3.11-slim@sha256:272efc3f94bec901e2bc7a5c9984b3d113c317839edca2714c6a388b9476f8fc

ARG OPENVOICE_REVISION=74a1d147b17a8c3092dd5430504bd83ef6c7eb23
ARG CANDIDATE_LOCK_DIGEST=d56c6da1f8ca807460085f7eb982313aeedc5be33b730d0cd2aab601018e28dd
ARG ESPEAK_RUNTIME_MANIFEST_DIGEST=9af3512043451d19ce36cd3721da52231d6e28931d44b2ffbd07cce6350be373

LABEL org.opencontainers.image.title="Clicko Kokoro OpenVoice clone benchmark candidate" \
      org.opencontainers.image.version="0.1.0-evaluation" \
      org.opencontainers.image.revision="${OPENVOICE_REVISION}" \
      io.clicko.providers="none" \
      io.clicko.candidate="kokoro-openvoice-v2" \
      io.clicko.candidate.status="evaluation" \
      io.clicko.dependency-lock.digest="${CANDIDATE_LOCK_DIGEST}" \
      io.clicko.espeak-runtime-manifest.digest="${ESPEAK_RUNTIME_MANIFEST_DIGEST}" \
      io.clicko.weights="external-manifested-mount-only" \
      io.clicko.legal-review="wavmark-wheel-and-espeak-distribution-required"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 clicko \
    && install -d -o clicko -g clicko /tmp/clicko-speech

COPY --from=dependencies /opt/clicko/candidate /opt/clicko/candidate
COPY --from=dependencies /opt/clicko/espeak-runtime /opt/clicko/espeak-runtime-evidence
COPY --from=source-audit /src/openvoice/LICENSE /opt/clicko/notices/openvoice-LICENSE
COPY workers/speech-gpu/sidecars/kokoro_openvoice_clone.py /opt/clicko/sidecars/kokoro_openvoice_clone.py

ENV PATH="/opt/clicko/candidate/.venv/bin:${PATH}" \
    HOME="/home/clicko" \
    TMPDIR="/tmp/clicko-speech" \
    NUMBA_CACHE_DIR="/tmp/clicko-speech" \
    HF_HOME="/tmp/clicko-speech/huggingface" \
    XDG_CACHE_HOME="/tmp/clicko-speech/cache" \
    TORCH_HOME="/tmp/clicko-speech/torch" \
    HF_HUB_OFFLINE="1" \
    TRANSFORMERS_OFFLINE="1"

USER clicko
WORKDIR /tmp/clicko-speech

ENTRYPOINT ["/opt/clicko/candidate/.venv/bin/python", "/opt/clicko/sidecars/kokoro_openvoice_clone.py"]
CMD ["--help"]
