# syntax=docker/dockerfile:1.7
ARG OPENVOICE_SOURCE_IMAGE
FROM ${OPENVOICE_SOURCE_IMAGE} AS audited-sources

FROM python:3.11-slim@sha256:272efc3f94bec901e2bc7a5c9984b3d113c317839edca2714c6a388b9476f8fc AS dependencies
ARG CPU_LOCK_DIGEST=3255154038b7bd3896dc51ecec5b0fbb483d0767e592b79eff7f176b6590b6c1
COPY --from=ghcr.io/astral-sh/uv:0.12.3@sha256:dfd1e6972e100ca2fbf1f391effc3dd4aa57f319bf03c3e321e0a3f3341ed5af /uv /usr/local/bin/uv
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates git libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/clicko/candidate
COPY workers/speech-cpu/openvoice-candidate/pyproject.toml ./pyproject.toml
COPY workers/speech-cpu/openvoice-candidate/uv.lock ./uv.lock
RUN test "$(sha256sum uv.lock | awk '{print $1}')" = "${CPU_LOCK_DIGEST}" \
    && uv sync --frozen --no-dev --no-install-project
COPY --from=audited-sources /wheels /wheels
RUN uv pip install --python .venv/bin/python --no-deps /wheels/*.whl
COPY backend/scripts/install_espeak_runtime_replacement.py /opt/clicko/install_espeak.py
COPY .candidate-build/espeak-runtime /opt/clicko/espeak-runtime
COPY .candidate-build/espeak-runtime.manifest.json /opt/clicko/espeak-runtime.manifest.json
RUN loader_root="$(.venv/bin/python -c 'from pathlib import Path; import espeakng_loader; print(Path(espeakng_loader.__file__).parent)')" \
    && .venv/bin/python /opt/clicko/install_espeak.py \
      --manifest /opt/clicko/espeak-runtime.manifest.json --runtime-root /opt/clicko/espeak-runtime \
      --loader-root "${loader_root}" \
      --expected-manifest-digest 9af3512043451d19ce36cd3721da52231d6e28931d44b2ffbd07cce6350be373 \
    && HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 .venv/bin/python -c \
      "import importlib.metadata as m; import torch, wavmark; from openvoice.api import ToneColorConverter; from kokoro import KPipeline; assert m.version('torch') == '2.6.0+cpu'; assert not torch.cuda.is_available(); assert not any(d.metadata.get('Name','').startswith('nvidia-') for d in m.distributions())"

FROM python:3.11-slim@sha256:272efc3f94bec901e2bc7a5c9984b3d113c317839edca2714c6a388b9476f8fc
ARG CPU_LOCK_DIGEST=3255154038b7bd3896dc51ecec5b0fbb483d0767e592b79eff7f176b6590b6c1
LABEL io.clicko.candidate="kokoro-openvoice-cpu" \
      io.clicko.candidate.status="evaluation" io.clicko.providers="none" \
      io.clicko.execution-device="cpu" io.clicko.dependency-lock.digest="${CPU_LOCK_DIGEST}" \
      io.clicko.openvoice.watermark-patch.digest="fbc61b661289010fe0815437c464351f71d1107066b2b3781255fc54916d2d92"
RUN apt-get update && apt-get install --yes --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 clicko
COPY --from=dependencies /opt/clicko/candidate /opt/clicko/candidate
COPY --from=audited-sources /src/openvoice/LICENSE /opt/clicko/notices/openvoice-LICENSE
COPY --from=audited-sources /src/kokoro/LICENSE /opt/clicko/notices/kokoro-LICENSE
COPY --from=dependencies /opt/clicko/espeak-runtime /opt/clicko/espeak-runtime-evidence
COPY backend/app/domain /opt/clicko/backend/app/domain
COPY backend/app/__init__.py /opt/clicko/backend/app/__init__.py
COPY workers/speech-gpu/sidecars/kokoro_openvoice_clone.py /opt/clicko/sidecars/kokoro_openvoice_clone.py
COPY workers/speech-cpu/sidecars/openvoice_cpu.py /opt/clicko/sidecars/openvoice_cpu.py
COPY workers/speech-gpu/openvoice-model-assets.v1.json /opt/clicko/openvoice-model-assets.json
COPY .candidate-build/kokoro-model-assets.json /opt/clicko/kokoro-model-assets.json
COPY workers/speech-cpu/openvoice.worker.manifest.json /opt/clicko/worker-manifest.json
ARG CPU_WORKER_MANIFEST_DIGEST
LABEL io.clicko.worker-manifest.digest="${CPU_WORKER_MANIFEST_DIGEST}" \
      io.clicko.model-manifest.digest="035360cd1f63378a6bd0f8b951b6de859f2fb961a61a2f5d7dcf627a90459d7c" \
      io.clicko.base-model-manifest.digest="4c738811001691c1640ec65230d9f5dc3008f80c8a7b8af027822c534be09af9"
ENV PATH="/opt/clicko/candidate/.venv/bin:${PATH}" PYTHONPATH="/opt/clicko/backend" \
    HF_HUB_OFFLINE="1" TRANSFORMERS_OFFLINE="1" \
    OMP_NUM_THREADS="4" MKL_NUM_THREADS="4" OPENBLAS_NUM_THREADS="4" NUMEXPR_NUM_THREADS="4" \
    TMPDIR="/run/clicko-runtime" NUMBA_CACHE_DIR="/run/clicko-runtime/numba" \
    HF_HOME="/run/clicko-runtime/hf" XDG_CACHE_HOME="/run/clicko-runtime/cache"
RUN python -c "import hashlib,json; from pathlib import Path; from app.domain.studios.contracts import StudioWorkerRuntimeManifestV1 as M; m=M.model_validate_json(Path('/opt/clicko/worker-manifest.json').read_text()); d=hashlib.sha256(json.dumps(m.model_dump(by_alias=True,mode='json'),ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()).hexdigest(); assert d == '${CPU_WORKER_MANIFEST_DIGEST}'"
USER clicko
WORKDIR /opt/clicko/sidecars
ENTRYPOINT ["python", "openvoice_cpu.py"]
CMD ["--help"]
