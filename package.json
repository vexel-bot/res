{
  "name": "clicko-ai-studios",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "tsx server.ts",
    "dev:api": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts",
    "import:stitch": "tsx scripts/import-stitch.ts",
    "test:stitch": "tsx scripts/verify-stitch-coverage.ts",
    "test:design-contract": "tsx scripts/verify-design-contract.ts",
    "test:e2e": "playwright test",
    "test:backend": "cd backend && python -m pytest",
    "lint:backend": "cd backend && python -m ruff check ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "simple-icons": "^16.28.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
