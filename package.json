{
  "name": "clicko-ai-studios",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && esbuild server/klic/attachmentWorker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/attachmentWorker.cjs",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "migrate:social": "node scripts/migrate-social.mjs",
    "validate:production": "node scripts/validate-production-env.mjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-audit-tests.cjs"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.2",
    "openapi-fetch": "^0.17.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "simple-icons": "^16.28.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "qs": "^6.16.0"
  }
}
