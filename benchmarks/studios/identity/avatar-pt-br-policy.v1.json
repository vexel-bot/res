  "thresholds": [
    {
      "metricId": "human_visual_realism_mos",
      "displayName": "Realismo visual humano MOS",
      "unit": "mos_1_5",
      "aggregation": "mean",
      "direction": "minimum",
      "threshold": 4.0,
      "minimumSamples": 90,
      "rationale": "Three blinded reviews per 30-case corpus."
    },
    {
      "metricId": "identity_similarity_cosine",
      "displayName": "Similaridade de identidade facial",
      "unit": "cosine_similarity",
      "aggregation": "mean",
      "direction": "minimum",
      "threshold": 0.8,
      "minimumSamples": 30,
      "rationale": "Identity preservation is a blocking property, with the evaluator model pinned in evidence."
    },
    {
      "metricId": "critical_face_artifact_rate",
      "displayName": "Artefatos críticos em boca, dentes, olhos ou bordas",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "maximum",
      "threshold": 0.01,
      "minimumSamples": 30,
      "rationale": "A visible critical defect makes an ad unusable even when average quality is high."
    },
    {
      "metricId": "temporal_jitter_failure_rate",
      "displayName": "Falha perceptível de consistência temporal",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "maximum",
      "threshold": 0.02,
      "minimumSamples": 30,
      "rationale": "Single-frame and diffusion pipelines must remain stable across cuts and head motion."
    },
    {
      "metricId": "lip_sync_acceptance_rate",
      "displayName": "Aceitação humana de lip-sync",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "minimum",
      "threshold": 0.95,
      "minimumSamples": 30,
      "appliesToRoles": ["lip_sync", "photo_avatar"],
      "rationale": "Lip-sync must read correctly to native pt-BR reviewers across plosives and dental phonemes."
    },
    {
      "metricId": "p95_av_sync_offset_ms",
      "displayName": "Offset audiovisual absoluto p95",
      "unit": "milliseconds",
      "aggregation": "p95",
      "direction": "maximum",
      "threshold": 80.0,
      "minimumSamples": 30,
      "appliesToRoles": ["lip_sync", "photo_avatar"],
      "rationale": "Eighty milliseconds is approximately two frames at 25 fps and is the pre-run tolerance ceiling."
    },
    {
      "metricId": "pose_transfer_acceptance_rate",
      "displayName": "Aceitação de pose e expressão",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "minimum",
      "threshold": 0.95,
      "minimumSamples": 30,
      "appliesToRoles": ["motion", "photo_avatar"],
      "rationale": "Motion must follow the approved template without identity drift or implausible deformation."
    },
    {
      "metricId": "p95_real_time_factor",
      "displayName": "RTF p95",
      "unit": "ratio",
      "aggregation": "p95",
      "direction": "maximum",
      "threshold": 6.0,
      "minimumSamples": 30,
      "rationale": "Avatar generation is asynchronous, but six times real time is the ceiling for the first production loop."
    },
    {
      "metricId": "peak_vram_gb",
      "displayName": "Pico de VRAM",
      "unit": "gb",
      "aggregation": "maximum",
      "direction": "maximum",
      "threshold": 24.0,
      "minimumSamples": 30,
      "rationale": "The first dedicated identity worker budget is one 24 GB accelerator."
    },
    {
      "metricId": "usd_per_output_minute",
      "displayName": "Custo direto por minuto gerado",
      "unit": "usd_per_output_minute",
      "aggregation": "mean",
      "direction": "maximum",
      "threshold": 0.8,
      "minimumSamples": 30,
      "rationale": "Provisional ceiling for async avatar compute before product margin."
    },
    {
      "metricId": "job_failure_rate",
      "displayName": "Taxa de falha de job",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "maximum",
      "threshold": 0.02,
      "minimumSamples": 30,
      "rationale": "Retries cannot hide systematic failures on pose, occlusion or long duration."
    },
    {
      "metricId": "derived_cleanup_success_rate",
      "displayName": "Exclusão de derivados do benchmark",
      "unit": "ratio",
      "aggregation": "rate",
      "direction": "exact",
      "threshold": 1.0,
      "minimumSamples": 30,
      "rationale": "All identity-bound frames, crops, embeddings and outputs must be physically deleted and evidenced."
    }
  ],
  "requiredControls": [
    "commercial_license_chain_approved",
    "consent_verified",
    "source_assets_private",
    "tenant_isolation_verified",
    "no_egress_verified",
    "revocation_rechecked_at_enqueue",
    "human_review_completed",
    "abuse_safety_review_passed",
    "synthetic_disclosure_present",
    "synthetic_provenance_emitted",
    "deletion_cleanup_verified"
  ],
  "requiredEvidence": [
    "private_corpus_manifest",
    "license_manifest",
    "model_weight_manifest",
    "container_sbom",
    "raw_metric_bundle",
    "metric_evaluator_manifest",
    "blinded_human_review",
    "frame_level_qc_bundle",
    "cleanup_receipt"
  ],
  "notes": [
    "Thresholds are pre-run product policy, not empirical claims about any candidate.",
    "MuseTalk and LatentSync code licenses do not resolve their model-weight and auxiliary-model licenses.",
    "LivePortrait remains blocked until the bundled non-commercial InsightFace detector is replaced and pinned.",
    "No real face, video, consent record, asset path or biometric embedding belongs in this repository."
  ]
}
