  "thresholds": [
    {"metricId":"human_visual_realism_mos","displayName":"Realismo visual humano MOS","unit":"mos_1_5","aggregation":"mean","direction":"minimum","threshold":4.0,"minimumSamples":288,"minimumUniqueReviewers":3,"minimumRatingsPerCase":3,"rationale":"Every one of the 96 outputs receives three blinded ratings."},
    {"metricId":"avatar_profile_pass_rate","displayName":"Perfis aprovados individualmente","unit":"ratio","aggregation":"rate","direction":"exact","threshold":1.0,"minimumSamples":6,"rationale":"A catalog average cannot hide a failed presenter."},
    {"metricId":"critical_identity_artifact_rate","displayName":"Artefatos críticos de identidade","unit":"ratio","aggregation":"rate","direction":"maximum","threshold":0.01,"minimumSamples":96,"rationale":"Mouth, teeth, eyes, hands, edges or identity drift make an ad unusable."},
    {"metricId":"lip_sync_acceptance_rate","displayName":"Aceitação humana de lip-sync pt-BR","unit":"ratio","aggregation":"rate","direction":"minimum","threshold":0.95,"minimumSamples":96,"rationale":"Native reviewers assess phonetic and perceptual sync."},
    {"metricId":"p95_av_sync_offset_ms","displayName":"Offset audiovisual absoluto p95","unit":"milliseconds","aggregation":"p95","direction":"maximum","threshold":80.0,"minimumSamples":96,"rationale":"Two frames at 25 fps is the pre-run ceiling."},
    {"metricId":"ad_message_acceptance_rate","displayName":"Aceitação de hook, tese, benefício e CTA","unit":"ratio","aggregation":"rate","direction":"minimum","threshold":0.9,"minimumSamples":96,"rationale":"Avatar quality does not compensate for an incoherent advertisement."},
    {"metricId":"physical_continuity_failure_rate","displayName":"Falhas de continuidade física/temporal","unit":"ratio","aggregation":"rate","direction":"maximum","threshold":0.02,"minimumSamples":96,"rationale":"Contact, occlusion, scale, trajectories and scene continuity are reviewed per output."},
    {"metricId":"regeneration_rate","displayName":"Taxa de regeneração necessária","unit":"ratio","aggregation":"rate","direction":"maximum","threshold":0.15,"minimumSamples":96,"rationale":"Repeated retries are both a quality and cost failure."},
    {"metricId":"peak_vram_gb","displayName":"Pico de VRAM na lane MVP","unit":"gb","aggregation":"maximum","direction":"maximum","threshold":24.0,"minimumSamples":24,"appliesToRoles":["talking_head","body_avatar"],"rationale":"The first standard avatar worker is one 24 GB accelerator; Wan remains an advanced lane."},
    {"metricId":"usd_per_output_minute","displayName":"Custo direto por minuto final","unit":"usd_per_output_minute","aggregation":"mean","direction":"maximum","threshold":0.8,"minimumSamples":96,"rationale":"Pre-run unit economics ceiling, distinct from the experiment authorization cap."},
    {"metricId":"job_failure_rate","displayName":"Taxa de falha terminal","unit":"ratio","aggregation":"rate","direction":"maximum","threshold":0.02,"minimumSamples":96,"rationale":"Retries may not hide systematic provider failures."},
    {"metricId":"cleanup_success_rate","displayName":"Exclusão física de derivados","unit":"ratio","aggregation":"rate","direction":"exact","threshold":1.0,"minimumSamples":96,"rationale":"Every biometric derivative must be deleted and evidenced after the private benchmark."}
