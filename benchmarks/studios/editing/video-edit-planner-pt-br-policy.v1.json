  "thresholds": [
    {"metricId":"structured_output_validity_rate","displayName":"Saídas válidas no contrato","unit":"ratio","aggregation":"rate","direction":"exact","threshold":1.0,"minimumSamples":24,"rationale":"Invalid planner output must never mutate a CreativeDocument."},
    {"metricId":"unsupported_edit_operation_rate","displayName":"Operações de edição não suportadas","unit":"ratio","aggregation":"rate","direction":"exact","threshold":0.0,"minimumSamples":24,"rationale":"The planner may only propose registered operations."},
    {"metricId":"mean_timecode_iou","displayName":"IoU dos intervalos propostos","unit":"iou","aggregation":"mean","direction":"minimum","threshold":0.75,"minimumSamples":24,"rationale":"Cut and evidence intervals are compared with a frozen human reference."},
    {"metricId":"critical_event_recall","displayName":"Recall de eventos críticos","unit":"ratio","aggregation":"rate","direction":"minimum","threshold":0.95,"minimumSamples":24,"rationale":"Fast motion, product reveal, claims and continuity risks cannot be silently missed."},
    {"metricId":"evidence_binding_rate","displayName":"Propostas ligadas a timecodes/evidências","unit":"ratio","aggregation":"rate","direction":"exact","threshold":1.0,"minimumSamples":24,"rationale":"Every material edit proposal needs an evidence reference or explicit creative rationale."},
    {"metricId":"required_abstention_rate","displayName":"Abstenção correta em ambiguidade","unit":"ratio","aggregation":"rate","direction":"minimum","threshold":0.9,"minimumSamples":24,"rationale":"A safe planner asks for review instead of inventing certainty."},
    {"metricId":"human_edit_usefulness_mos","displayName":"Utilidade editorial humana MOS","unit":"mos_1_5","aggregation":"mean","direction":"minimum","threshold":4.0,"minimumSamples":72,"minimumUniqueReviewers":3,"minimumRatingsPerCase":3,"rationale":"Three blinded specialists rate each proposal."},
    {"metricId":"p95_latency_seconds","displayName":"Latência p95 por minuto analisado","unit":"seconds_per_input_minute","aggregation":"p95","direction":"maximum","threshold":120.0,"minimumSamples":24,"rationale":"Planning remains asynchronous but must support an interactive review loop."},
    {"metricId":"usd_per_input_minute","displayName":"Custo direto por minuto analisado","unit":"usd_per_input_minute","aggregation":"mean","direction":"maximum","threshold":0.10,"minimumSamples":24,"rationale":"Provisional challenger ceiling before product margin."}
  ],
