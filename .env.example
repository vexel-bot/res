# OpenAI-compatible planning/comprehension sidecar. These values do not grant
# access to the Clicko HTTP API. Keep all three unset until a reviewed provider
# is actually running; the backend fails closed when the tuple is incomplete.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_EMBEDDING_MODEL=""

# Gemini key ring. Legacy API_1/API_2 names are accepted by the backend, but
# new environments should use these explicit names. Keys are SecretStr values
# and must never be logged. Outbound and video generation remain fail-closed;
# enabling paid video also requires a positive spend limit.
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_OUTBOUND_ENABLED=false
GEMINI_VIDEO_GENERATION_ENABLED=false
GEMINI_MAX_EXTERNAL_SPEND_USD=0
OPENAI_API_KEY=
OPENAI_OUTBOUND_ENABLED=false
OPENAI_VIDEO_GENERATION_ENABLED=false
OPENAI_MAX_EXTERNAL_SPEND_USD=0

# Local FastAPI origin used by the Node/Vite BFF in development.
CLICKO_API_ORIGIN="http://127.0.0.1:8000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Rollback switch for the authenticated Visual/Carousel Studio adapter.
VITE_STUDIO_KERNEL_ENABLED=true
# Rollback switch for the typed canonical route/shell boundary.
VITE_CANONICAL_CX_SHELLS=true
VITE_CANONICAL_CX_ROUTES=true
RADAR_CONTEXTUAL_V2_ENABLED=false
RADAR_CONTEXTUAL_V2_SHADOW_MODE=false

# Test-only escape hatch. Production startup rejects this setting when true.
CELERY_TASK_ALWAYS_EAGER=false

# Large Studio assets remain local by default. Switch to "s3" only after a
# private S3-compatible bucket and lifecycle policy have been provisioned.
OBJECT_STORAGE_BACKEND="local"
STORAGE_PATH="./data/uploads"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT_URL=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_SIGNED_URL_SECONDS=900

# Rollout gate: keep false until dedicated workers are deployed for every queue.
STUDIO_ISOLATED_QUEUES_ENABLED=false
# Set only inside a dedicated worker runtime. The API/control plane leaves these empty.
STUDIO_WORKER_MANIFEST_PATH=""
STUDIO_WORKER_CAPABILITY=""
STUDIO_WORKER_INSTANCE_ID=""
# Required for production workers and supplied by the orchestrator after image promotion.
STUDIO_WORKER_IMAGE_DIGEST=""

# Destructive privacy workflow. Keep false until retention/legal-hold policy,
# shared object storage and the dedicated control worker have been validated.
IDENTITY_DELETION_EXECUTION_ENABLED=false
FFPROBE_PATH="ffprobe"
FFPROBE_TIMEOUT_SECONDS=120
FFMPEG_PATH="ffmpeg"
FFMPEG_TIMEOUT_SECONDS=1800
STUDIO_UGC_FONT_PATH=""

# Disabled until a dedicated media worker ships pinned Node/Chrome/FFmpeg/fonts.
HYPERFRAMES_ENABLED=false
HYPERFRAMES_NODE_PATH="node"
HYPERFRAMES_CLI_PATH=""
HYPERFRAMES_TIMEOUT_SECONDS=7200

# Contextual video editing: native Gemini, separate from the legacy key ring above.
# Never place these values in VITE_* variables. Production does not use the test key.
STUDIO_GEMINI_ENABLED=false
# Primary adapter; each role can be overridden independently. No automatic failover or paid calls on configuration.
STUDIO_EDITING_AI_PROVIDER="gemini"
# Optional role overrides: planning supports gemini/compatible/none; image/video support gemini/none today.
# STUDIO_EDITING_AI_PLANNING_PROVIDER="compatible"
# STUDIO_EDITING_AI_IMAGE_PROVIDER="gemini"
# STUDIO_EDITING_AI_VIDEO_PROVIDER="gemini"
# Compatible planning endpoint includes its API prefix (for example https://your-provider.example/v1).
# Requires multimodal Chat Completions, JSON output and an explicitly pinned response model ID.
STUDIO_EDITING_AI_BASE_URL=""
STUDIO_EDITING_AI_MODEL=""
STUDIO_EDITING_AI_TEST_KEY=""
STUDIO_EDITING_AI_PRODUCTION_KEY=""
STUDIO_EDITING_AI_TEST_BUDGET_USD=0
# Hard aggregate envelope for one production correlation in development/test.
STUDIO_PRODUCTION_TEST_BUDGET_USD=0
STUDIO_VISUAL_QUALITY_INDICATOR_ENABLED=false
STUDIO_EDITING_AI_PRICE_VERSION="unpriced"
# Required when the hard production-test envelope is active. Pin these to the selected model's official tariff.
STUDIO_EDITING_AI_INPUT_USD_PER_MILLION=0
STUDIO_EDITING_AI_OUTPUT_USD_PER_MILLION=0
STUDIO_EDITING_AI_MAX_OUTPUT_TOKENS=4096
STUDIO_EDITING_AI_MAX_PROMPT_CHARS=100000
# Optional native video adapter. Gemini remains the default; no silent failover.
# STUDIO_EDITING_AI_VIDEO_PROVIDER="runway"
STUDIO_RUNWAY_ENABLED=false
STUDIO_RUNWAY_TEST_KEY=""
STUDIO_RUNWAY_PRODUCTION_KEY=""
STUDIO_RUNWAY_TEST_BUDGET_USD=0
STUDIO_RUNWAY_OUTPUT_HOSTS='["dnznrvs05pmza.cloudfront.net"]'
STUDIO_GEMINI_PRODUCTION_KEY=""
STUDIO_GEMINI_TEST_KEY=""
STUDIO_GEMINI_PLANNING_MODEL="gemini-3.8-flash"
STUDIO_GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"
STUDIO_GEMINI_VIDEO_MODEL="gemini-omni-1.1-flash"
# Only controls local/test requests; no monthly/per-video production spending cap.
# Conservative reservations include generation and visual verification, not a provider invoice.
STUDIO_GEMINI_TEST_BUDGET_USD=0
STUDIO_GEMINI_INPUT_USD_PER_MILLION=0
STUDIO_GEMINI_OUTPUT_USD_PER_MILLION=0
STUDIO_GEMINI_IMAGE_RESERVATION_USD=0.10
GOOGLE_FONTS_API_KEY=""
PEXELS_API_KEY=""
# Brandfetch Logo API is discovery/preview only. A render still requires an authorized asset.
BRANDFETCH_CLIENT_ID=""
# Local background removal refuses to download weights. Pin a reviewed U2-Net model file and checksum.
STUDIO_BACKGROUND_REMOVAL_ENABLED=false
STUDIO_BACKGROUND_REMOVAL_PYTHON_PATH=""
STUDIO_BACKGROUND_REMOVAL_MODEL_PATH=""
STUDIO_BACKGROUND_REMOVAL_MODEL_SHA256=""
# Experimental local T2V worker. Keep disabled unless `preflight.py` reports
# admitted; the backend accepts loopback only and never enables a paid fallback.
STUDIO_LOCAL_DIFFUSION_ENABLED=false
STUDIO_LOCAL_DIFFUSION_URL="http://127.0.0.1:8094"
STUDIO_LOCAL_DIFFUSION_TOKEN=""
# Exact HTTPS hosts permitted for imported files. Redirects must also stay on registered public hosts.
STUDIO_RESOURCE_HOSTS='["fonts.gstatic.com"]'
