# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Server-only model for contextual KLIC chat and image understanding.
KLIC_CHAT_MODEL="gemini-2.5-flash"
# Server-only audio transcription model. This remains independent from chat.
KLIC_TRANSCRIPTION_MODEL="gemini-3.5-flash"
# Keep false when using GEMINI_API_KEY. GOOGLE_API_KEY is intentionally ignored
# by KLIC because it may belong to YouTube/Radar.
GOOGLE_GENAI_USE_VERTEXAI="false"
# Alternative to GEMINI_API_KEY: Vertex AI with server-side Application Default Credentials.
# This is opt-in; TTS credentials alone do not activate or authorize Gemini.
# Enable aiplatform.googleapis.com and grant the runtime identity Vertex AI access in Google Cloud.
# Set GOOGLE_GENAI_USE_VERTEXAI="true" only when Vertex was explicitly chosen.
# GOOGLE_CLOUD_LOCATION="global"
# Configuration is not proof of provider availability: validate with a real chat request.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Canonical HTTPS origin used by production OAuth callbacks. It must not contain
# a path, query string or fragment. In local development APP_URL remains enough.
# PUBLIC_APP_URL="https://app.example.com"

# Local governance persistence (server-side). Keep outside public/ and dist/.
# Mount a persistent volume at this location when deploying a single server.
# Default: .clicko-data/governance.json relative to the server working directory.
# CLICKO_GOVERNANCE_DATA_FILE="C:/secure-data/clicko/governance.json"

# KLIC Google Cloud Text-to-Speech (server-side only)
# Enable only after Application Default Credentials are available to the server.
KLIC_GOOGLE_TTS_ENABLED="false"
GOOGLE_CLOUD_PROJECT="MY_GOOGLE_CLOUD_PROJECT_ID"

# Local development only: path to a credential file stored outside the repository.
# In Google Cloud production, attach a service account to the runtime instead.
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/path/clicko-tts-service-account.json"

# Optional custom/regional API endpoint. Leave commented to use Google's default endpoint.
# GOOGLE_CLOUD_TTS_API_ENDPOINT="texttospeech.googleapis.com"

# Authentication (server-side)
# Keep false until an email delivery provider is connected. When false, new
# accounts are activated immediately; password recovery still generates secure
# expiring tokens but requires a delivery integration for production use.
AUTH_EMAIL_VERIFICATION_REQUIRED="false"

# Local development only. Returns verification/reset tokens to the local UI so
# flows can be tested without email delivery. Never enable in production.
AUTH_DEV_EXPOSE_TOKENS="false"
# Optional local authentication bypass. It is honored only when NODE_ENV is
# exactly "development" and never ships as a client-side VITE_* variable.
CLICKO_DEV_AUTH_BYPASS="false"
# Selects the initial standard account context; both remain available locally.
CLICKO_DEV_AUTH_BYPASS_PROFILE="company"

# Billing (Stripe, server-side only). Leave all values unset until checkout is
# configured. Access is activated only by a verified Stripe webhook.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_SOLO="price_..."
# STRIPE_PRICE_TEAM="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_ENTERPRISE="price_..."
# Optional price for each paid client operation managed by a subscriber.
# STRIPE_MANAGED_OPERATION_PRICE_ID="price_..."
# Explicit server-side exceptions only, comma-separated. Never expose as VITE_*.
# CLICKO_INTERNAL_ACCESS_WORKSPACE_IDS=""

# Social integrations (server-side only). Never expose these as VITE_* values.
# Development/test uses the atomic JSON adapter. Production defaults to the
# transactional PostgreSQL adapter and refuses an accidental JSON deployment.
SOCIAL_STORAGE_DRIVER="json"
# Production example: SOCIAL_STORAGE_DRIVER="postgres"
# SOCIAL_DATABASE_URL="postgresql://CLICKO_DB_USER:CLICKO_DB_PASSWORD@CLICKO_DB_HOST:5432/CLICKO_DB_NAME"
# SOCIAL_DATABASE_SSL="require"
# Development/single-instance path only; never place it in public/ or dist/.
# CLICKO_SOCIAL_DATA_FILE="C:/secure-data/clicko/social-integrations.json"
# Emergency single-instance production override. Keep false for SaaS.
SOCIAL_ALLOW_SINGLE_INSTANCE_STORE="false"
# Generate exactly 32 random bytes and encode them as base64url or 64 hex chars.
SOCIAL_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_RANDOM_BYTES_BASE64URL"
# During rotation, keep old keys comma-separated until every stored token has
# been re-encrypted or the affected accounts have reconnected.
# SOCIAL_TOKEN_ENCRYPTION_PREVIOUS_KEYS="PREVIOUS_KEY_BASE64URL,OLDER_KEY_BASE64URL"

# Meta OAuth for Facebook Pages and professional Instagram accounts.
META_APP_ID="MY_META_APP_ID"
META_APP_SECRET="MY_META_APP_SECRET"
META_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"
# Optional explicit Graph API version. Default: v23.0.
# META_GRAPH_VERSION="v23.0"

# TikTok Login Kit / Content Posting API.
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"

# Google OAuth 2.0 / YouTube Data API v3. The current adapter requests only
# youtube.readonly; upload remains unavailable until the resumable backend
# media pipeline exists.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"

# LinkedIn OAuth 2.0. Restricted organization/analytics scopes require approval.
LINKEDIN_CLIENT_ID="MY_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="MY_LINKEDIN_CLIENT_SECRET"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"
# LINKEDIN_SCOPES="openid profile email w_member_social"
# LINKEDIN_API_VERSION="202606"

# Threads API (Meta). Configure a dedicated Threads application.
THREADS_APP_ID="MY_THREADS_APP_ID"
THREADS_APP_SECRET="MY_THREADS_APP_SECRET"
THREADS_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"
# THREADS_SCOPES="threads_basic,threads_content_publish,threads_manage_insights,threads_read_replies,threads_manage_replies"
# THREADS_GRAPH_VERSION="v1.0"

# Pinterest API v5 OAuth.
PINTEREST_APP_ID="MY_PINTEREST_APP_ID"
PINTEREST_APP_SECRET="MY_PINTEREST_APP_SECRET"
PINTEREST_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"
# PINTEREST_SCOPES="user_accounts:read,boards:read,pins:read,pins:write"

# Radar: approved Pinterest Trends API token, server-side only. A standard
# Pinterest social OAuth connection does not automatically grant Trends access.
# RADAR_PINTEREST_ACCESS_TOKEN=""

# X API OAuth 2.0 with PKCE. Availability also depends on the API access plan.
X_CLIENT_ID="MY_X_CLIENT_ID"
X_CLIENT_SECRET="MY_X_CLIENT_SECRET"
X_REDIRECT_URI="http://localhost:3000/api/integrations/oauth/callback"
# X_SCOPES="tweet.read tweet.write users.read offline.access"

# Studios imported from DuduSilvaai's Craft branch. Development starts the
# isolated Python API automatically when .venv exists. In production run
# app.studio_app:app separately and share a private bridge secret with Node.
# CLICKO_STUDIOS_ORIGIN="http://127.0.0.1:8000"
# CLICKO_STUDIOS_BRIDGE_SECRET=""
