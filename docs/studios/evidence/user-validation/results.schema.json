{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clicko.local/schemas/cx-user-validation-1.0.0.json",
  "title": "Clicko CX-0 user validation study",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "surface", "participants", "results", "accessibilityRuns", "issues"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "studyId": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "url"],
      "properties": {
        "type": { "enum": ["figma", "build"] },
        "version": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "segment", "viewport"],
        "properties": {
          "participantId": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "segment": { "enum": ["creator", "reviewer", "publisher"] },
          "viewport": { "enum": ["desktop", "mobile"] }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "taskId", "firstClick", "firstClickSuccess", "taskResult", "timeToFirstClickMs", "taskTimeMs", "seq"],
        "properties": {
          "participantId": { "type": "string" },
          "taskId": { "enum": ["FC-1", "FC-2", "FC-3", "FC-4", "FC-5"] },
          "firstClick": { "type": "string" },
          "firstClickSuccess": { "type": "boolean" },
          "taskResult": { "enum": ["success", "assisted", "failed", "invalid_run"] },
          "timeToFirstClickMs": { "type": "integer", "minimum": 0 },
          "taskTimeMs": { "type": "integer", "minimum": 0 },
          "seq": { "type": "number", "minimum": 1, "maximum": 7 }
        }
      }
    },
    "accessibilityRuns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "method", "criticalJourneyCompleted", "severity3Issues"],
        "properties": {
          "participantId": { "type": "string" },
          "method": { "enum": ["keyboard", "screen-reader"] },
          "criticalJourneyCompleted": { "type": "boolean" },
          "severity3Issues": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issueId", "severity", "participantIds"],
        "properties": {
          "issueId": { "type": "string", "minLength": 1 },
          "severity": { "type": "integer", "minimum": 0, "maximum": 3 },
          "participantIds": { "type": "array", "items": { "type": "string" } },
          "screenId": { "type": "string" },
          "actionId": { "type": "string" },
          "route": { "type": "string" }
        }
      }
    }
  }
}
